name: Extract Flutter Project

on:
  workflow_dispatch:
  push:

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest

    steps:
      - name: Download repository
        uses: actions/checkout@v4

      - name: Extract ZIP
        run: |
          mkdir extracted
          unzip -o rawasi_alshahaqa_app_v1.zip -d extracted

          cp -R extracted/* .
          cp -R extracted/.[!.]* . 2>/dev/null || true

          rm -rf extracted
          rm -f rawasi_alshahaqa_app_v1.zip

      - name: Save project files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add .
          git commit -m "Extract Flutter project" || echo "Nothing to commit"
          git push
